{
  "name": "AuraCRM",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/CRM",
  "postCreateCommand": "pip install -r requirements.txt && python seed.py",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "AuraCRM", "onAutoForward": "openPreview" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
